# Azure AD / Microsoft Entra ID Configuration
# These values come from your Azure AD App Registration

# Client ID (Application ID) from Azure AD App Registration
VITE_AZURE_AD_CLIENT_ID=your-client-id-here

# Tenant ID from Azure AD (Directory ID)
VITE_AZURE_AD_TENANT_ID=your-tenant-id-here

# Redirect URI (must match the one configured in Azure AD App Registration)
# For local development, typically: http://localhost:5173
# For production SWA, use your SWA domain
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173

# API Scope for Azure Functions backend
# Format: api://<backend-client-id>/<scope-name>
# This is configured in the Azure AD App Registration for your backend
VITE_AZURE_AD_API_SCOPE=api://your-backend-client-id/access_as_user

# API Configuration
# For local development with separate backend, use the full URL
# For SWA, defaults to /api (proxied to Azure Functions)
VITE_API_BASE_URL=http://localhost:7071/api

# Environment
VITE_ENVIRONMENT=development

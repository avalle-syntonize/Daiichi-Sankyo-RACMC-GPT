# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and customize the values

# Environment Configuration
environment  = "dev"
location     = "East US"
project_name = "racmc-gpt"
# Note: Resource group name is automatically computed as rg-racmc-{environment}

# Tags for all resources
tags = {
  Project     = "RACMC-GPT"
  ManagedBy   = "Terraform"
  Environment = "dev"
  CostCenter  = "Engineering"
  Owner       = "Platform Team"
}

# Static Web App Configuration (Free Tier) - examples (uncomment if using Static Web App)
# static_web_app_sku_tier = "Free"
# static_web_app_sku_size = "Free"

# Container Apps Configuration (Consumption Tier) - examples (uncomment if using Container Apps)
# container_apps_sku_name = "Consumption"
# container_min_replicas  = 0  # Scale to zero when not in use
# container_max_replicas  = 2
# container_cpu           = 0.25  # 0.25 vCPU
# container_memory        = "0.5Gi"  # 0.5 GiB memory

# Set to true to create an example container app for demo/testing
# create_example_container_app = false

# AI Search Configuration (Free Tier)
ai_search_sku            = "free"  # Options: free, basic, standard
ai_search_replica_count  = 1
ai_search_partition_count = 1

# Storage Account Configuration
storage_account_tier        = "Standard"
storage_account_replication = "LRS"  # Locally Redundant Storage

# Key Vault Configuration
key_vault_sku = "standard"

# ACR + App Service examples (uncomment and adjust to use ACR + App Services)
# acr_sku = "Basic"
# frontend_image = "racmc-frontend"
# backend_image  = "racmc-backend"
# image_tag      = "latest"
# app_service_plan_tier = "Basic"
# app_service_plan_size = "B1"
